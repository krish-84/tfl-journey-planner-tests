<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 10 is the current LTS release (.NET 8 support ends November 2026). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TflJourneyPlanner.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI automation -->
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
    <PackageReference Include="NUnit.Analyzers" Version="4.7.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Gherkin / BDD (Reqnroll is the maintained successor to SpecFlow) -->
    <PackageReference Include="Reqnroll.NUnit" Version="3.3.4" />

    <!-- Test runner -->
    <PackageReference Include="NUnit" Version="4.3.2" />
    <PackageReference Include="NUnit3TestAdapter" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
  </ItemGroup>

</Project>
